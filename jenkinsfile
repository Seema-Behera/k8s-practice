pipeline {
  agent { label 'ns23-kube' }

  environment {
    REGISTRY_IMAGE = 'seema028/py-may26'
    CHART_DIR = 'helm-py-redis'
    RELEASE_NAME = 'py-redis'
    NAMESPACE = 'ns23'
    KUBECONFIG = "${HOME}/k8s-3-node.conf"
  }

  stages {

    stage('Checkout') {
      steps {
        git branch: 'main',
            credentialsId: 'ns23-github-cred',
            url: 'git@github.com:Seema-Behera/k8s-practice.git'
      }
    }

    stage('Check Tools') {
      steps {
        sh '''
          docker --version
          kubectl version --client
          helm version
        '''
      }
    }

    stage('Build Docker Image') {
      steps {
        sh '''
          docker build -t ${REGISTRY_IMAGE}:$BUILD_NUMBER app
        '''
      }
    }

    stage('Push Docker Image') {
      steps {
        withCredentials([
          usernamePassword(
            credentialsId: 'ns23-dockerhub-cred',
            usernameVariable: 'DOCKERHUB_USER',
            passwordVariable: 'DOCKERHUB_PASS'
          )
        ]) {
          sh '''
            echo "$DOCKERHUB_PASS" | docker login -u "$DOCKERHUB_USER" --password-stdin
            docker push ${REGISTRY_IMAGE}:$BUILD_NUMBER
            docker logout
          '''
        }
      }
    }

    stage('Helm Lint') {
      steps {
        sh '''
          export KUBECONFIG=$KUBECONFIG
          helm lint ${CHART_DIR}
        '''
      }
    }

    stage('Helm Template Validate') {
      steps {
        sh '''
          export KUBECONFIG=$KUBECONFIG
          helm template ${RELEASE_NAME} ${CHART_DIR} \
            --namespace ${NAMESPACE} \
            --set pythonApp.image.repository=${REGISTRY_IMAGE} \
            --set pythonApp.image.tag=$BUILD_NUMBER
        '''
      }
    }

    stage('Kubernetes Precheck') {
      steps {
        sh '''
          export KUBECONFIG=$KUBECONFIG
          kubectl get nodes
          kubectl get ns || true
          kubectl get pv || true
        '''
      }
    }

    stage('Helm Deploy') {
      steps {
        sh '''
          export KUBECONFIG=$KUBECONFIG

          kubectl create namespace ${NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -

          helm upgrade --install ${RELEASE_NAME} ${CHART_DIR} \
            --namespace ${NAMESPACE} \
            --set pythonApp.image.repository=${REGISTRY_IMAGE} \
            --set pythonApp.image.tag=$BUILD_NUMBER

          kubectl rollout status deployment/py-deploy-23 -n ${NAMESPACE} --timeout=180s
          kubectl rollout status deployment/redis-deploy-23 -n ${NAMESPACE} --timeout=180s
        '''
      }
    }

    stage('Verify Deployment') {
      steps {
        sh '''
          export KUBECONFIG=$KUBECONFIG
          kubectl get all -n ${NAMESPACE}
          kubectl get pvc -n ${NAMESPACE}
          kubectl get pv
        '''
      }
    }

    stage('Application Health Check') {
      steps {
        sh '''
          sleep 15
          curl -f http://172.31.6.85:31123
        '''
      }
    }
  }

  post {
    always {
      sh '''
        docker image ls | head
      '''
    }
    success {
      echo 'Build and Helm deployment completed successfully.'
    }
    failure {
      sh '''
        export KUBECONFIG=$KUBECONFIG
        kubectl get pods -n ${NAMESPACE} || true
        kubectl describe pods -n ${NAMESPACE} || true
      '''
      echo 'Pipeline failed. Check logs.'
    }
  }
}