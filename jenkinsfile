pipeline {
  agent {label 'ns23-kube'}
  stages {

    stage('Checkout') {
      steps {
        checkout scm #git-clone

      }
    }
    stage('Check on Kubernetes') {
      steps {
        sh '''
          export KUBECONFIG=.kube/k8s-3-node.conf
          kubectl get pods
          kubectl get svc
          kubectl get deployments
        '''
      }
    }
    stage('Deployment on Kubernetes') {
      steps {
        sh '''

          kubectl apply -f .

        '''
      }
    }
  }
}
