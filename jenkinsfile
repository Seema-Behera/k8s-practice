pipeline {
  agent {label 'ns23-kube'}
  stages {

    stage('Checkout') {
      steps {
        git branch: 'main',
                credentialsId: 'ns23-github-cred',
                url: 'git@github.com:Seema-Behera/k8s-practice.git'

      }
    }
    stage('Check the docker cli') {
      steps {
        sh "docker --version"
        sh "docker ps -a"
      }
    }
    stage('Build Docker Image') {
      steps {
        sh '''
          docker build -t seema028/py-may26:$BUILD_NUMBER app ####HUB-ID to be chnaged
        '''
      }
    }
        stage('Push Docker Image') {
        steps {
            withCredentials([
            usernamePassword(
                credentialsId: 'ns23-dockerhub-cred',
                usernameVariable: 'DOCKERHUB_USER',
                passwordVariable: 'DOCKERHUB_PASS'
            )
            ]) {
            sh '''
                echo "$DOCKERHUB_PASS" | docker login -u "$DOCKERHUB_USER" --password-stdin
                docker push seema028/$BUILD_NUMBER
                docker logout
            '''
            }
        }
    }
    stage('Deploy - Template and Apply') {
        steps {
            sh '''
            export KUBECONFIG=$HOME/k8s-3-node.conf
            kubectl apply -f pv.yaml -f pvc.yaml -f py-service.yaml -f redis-service.yaml -f redis-deploy.yaml
            export IMAGE_TAG=$BUILD_NUMBER
            envsubst < py-deploy.yaml | kubectl apply -f -
            kubectl rollout status deployment/py-deploy
            '''
        }
    }
    stage('Check on Kubernetes') {
      steps {
        sh '''
          export KUBECONFIG=$HOME/k8s-3-node.conf
          kubectl get pods
          kubectl get svc
          kubectl get deployments
        '''
      }
    }
    stage('Application Health Check') {
      steps {
        sh '''
          sleep 10
          curl http://172.31.6.85:31123
        '''
      }
    }
  }
}
