pipeline {
  agent {label 'ns23-kube'}
  stages {

    stage('Checkout') {
      steps {
        git branch: 'main',
                credentialsId: 'ns23-github-cred',
                url: 'git@github.com:Seema-Behera/k8s-practice.git'

      }
    }
    stage('Check the docker cli') {
      steps {
        sh "docker --version"
        sh "docker ps -a"
      }
    }
    stage('Build Docker Image') {
      steps {
        sh '''
          docker build -t seema028/py-may26:$BUILD_NUMBER app ####HUB-ID to be chnaged
        '''
      }
    }
    stage('Check on Kubernetes') {
      steps {
        sh '''
          export KUBECONFIG=$HOME/k8s-3-node.conf
          kubectl get pods
          kubectl get svc
          kubectl get deployments
        '''
      }
    }
    stage('Deployment on Kubernetes') {
      steps {
        sh '''
          export KUBECONFIG=$HOME/k8s-3-node.conf
          kubectl apply -f .

        '''
      }
    }
  }
}
